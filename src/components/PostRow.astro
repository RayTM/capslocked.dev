---
import type { Post } from '../data/posts';
import { postHref } from '../data/posts';

interface Props {
  post: Post;
  lang: string;
}

const { post, lang } = Astro.props;
const tr = post.translations[lang] || post.translations.en;
const href = postHref(post.slug, lang);
---

<a
  class="group flex justify-between items-center gap-md py-md border-b-thin border-outline-variant last:border-b-0 cursor-pointer"
  href={href}
>
  <div class="flex flex-col md:flex-row md:items-baseline gap-xs md:gap-md min-w-0">
    <span class="font-label-md text-label-md text-outline shrink-0 md:w-[120px]">{tr.date}</span>
    <h3 class="dot-font font-headline-md text-[18px] md:text-headline-md uppercase text-primary break-words min-w-0">
      {tr.title}
    </h3>
  </div>
  <span
    class="material-symbols-outlined text-outline group-hover:text-secondary group-hover:translate-x-1 transition-all shrink-0"
    aria-hidden="true"
  >arrow_forward</span>
</a>
