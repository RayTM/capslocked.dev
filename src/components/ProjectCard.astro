---
import type { Project } from '../data/projects';
import { projectHref } from '../data/projects';

interface Props {
  project: Project;
  lang: string;
  variant?: 'highlighted' | 'grid';
}

const { project, lang, variant = 'highlighted' } = Astro.props;
const tr = project.translations[lang] || project.translations.en;
const href = project.comingSoon ? undefined : projectHref(project.slug, lang);
const imgAlt = project.image.alt[lang as 'en' | 'de'] || project.image.alt.en;
const isComing = !!project.comingSoon;
---

{variant === 'highlighted' ? (
  <a href={href} class:list={[
    'group border-thin border-primary bg-surface-container-low brutalist-shadow-hover transition-all flex flex-col md:flex-row overflow-hidden block',
    isComing && 'opacity-50 pointer-events-none cursor-default',
  ]}>
    <div class="duotone-wrap relative overflow-hidden w-full md:w-2/5 shrink-0 border-b md:border-b-0 md:border-r border-primary">
      <img
        class="w-full h-64 md:h-full object-cover grayscale"
        alt={imgAlt}
        src={project.image.src}
      />
      {isComing && (
        <div class="absolute inset-0 flex items-center justify-center bg-black/60">
          <span class="font-headline-lg text-headline-lg text-white uppercase tracking-widest">COMING_SOON</span>
        </div>
      )}
    </div>
    <div class="p-md md:p-lg flex flex-col justify-center min-w-0">
      <div class="flex flex-wrap justify-between items-start gap-xs mb-sm">
        <h3 class="dot-font font-headline-md text-[20px] md:text-headline-md uppercase break-words min-w-0">{tr.title}</h3>
        <span class="font-label-sm text-[10px] md:text-label-sm px-xs py-base border-thin border-secondary text-secondary shrink-0">{tr.status}</span>
      </div>
      <p class="font-body-md text-body-md text-on-surface-variant mb-md">{tr.description}</p>
      <div class="flex flex-wrap gap-x-sm gap-y-xs">
        {project.tags.map((tag) => (
          <span class="font-label-sm text-[10px] md:text-label-sm text-outline uppercase">{tag[lang as 'en' | 'de'] || tag.en}</span>
        ))}
      </div>
    </div>
  </a>
) : (
  <a href={href} class:list={[
    'group border-thin border-primary bg-surface-container-low brutalist-shadow-hover transition-all flex flex-col overflow-hidden block',
    isComing && 'opacity-50 pointer-events-none cursor-default',
  ]}>
    <div class="duotone-wrap relative overflow-hidden border-b border-primary">
      <img
        class="w-full h-72 object-cover grayscale"
        alt={imgAlt}
        src={project.image.src}
      />
      {isComing && (
        <div class="absolute inset-0 flex items-center justify-center bg-black/60">
          <span class="font-headline-lg text-headline-lg text-white uppercase tracking-widest">COMING_SOON</span>
        </div>
      )}
    </div>
    <div class="p-md md:p-lg flex flex-col justify-center flex-grow min-w-0">
      <div class="flex flex-wrap justify-between items-start gap-xs mb-sm">
        <h3 class="dot-font font-headline-md text-[20px] md:text-headline-md uppercase break-words min-w-0">{tr.title}</h3>
        <span class="font-label-sm text-[10px] md:text-label-sm px-xs py-base border-thin border-secondary text-secondary shrink-0">{tr.status}</span>
      </div>
      <p class="font-body-md text-body-md text-on-surface-variant mb-md">{tr.description}</p>
      <div class="flex flex-wrap gap-x-sm gap-y-xs">
        {project.tags.map((tag) => (
          <span class="font-label-sm text-[10px] md:text-label-sm text-outline uppercase">{tag[lang as 'en' | 'de'] || tag.en}</span>
        ))}
      </div>
    </div>
  </a>
)}
