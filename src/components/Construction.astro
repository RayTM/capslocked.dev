---
import { t } from '../data/i18n';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const buildDate = new Date().toISOString().replace('T', ' ').slice(0, 19);
---

<main class="relative min-h-screen w-full flex flex-col items-center justify-center construction-grid p-lg overflow-hidden">
  <div class="construction-scanline pointer-events-none z-50"></div>

  <div class="relative flex flex-col items-center text-center max-w-4xl">
    <!-- Structural frame (top-left) -->
    <div class="absolute -top-xl -left-xl w-md h-md border-t-thick border-l-thick border-secondary-container hidden md:block"></div>

    <!-- Metadata header -->
    <div class="mb-md flex items-center gap-xs">
      <span class="font-label-sm text-label-sm uppercase tracking-[0.2em] text-secondary-container bg-background px-base py-1 border-thin border-outline-variant">
        Protocol: 0x404_CONSTRUCTION
      </span>
      <span class="w-2 h-2 bg-secondary-container animate-pulse"></span>
    </div>

    <!-- Hero -->
    <h1 class="font-headline-xl text-[40px] md:text-headline-xl text-primary uppercase leading-tight mb-sm">
      SYSTEM<span class="text-secondary-container">_</span>OFFLINE
    </h1>

    <!-- Terminal-style subtext -->
    <div class="border-thin border-outline-variant bg-surface-container-low p-md mb-lg w-full">
      <p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-widest text-left">
        &gt; DEPLOYING_CORE_MODULES...<br/>
        &gt; STATUS: MAINTENANCE_MODE_ACTIVE<br/>
        &gt; ESTIMATED_REBOOT: PENDING_ROOT_ACCESS
      </p>
    </div>

    <!-- Brutalist button -->
    <div class="relative group">
      <div class="absolute inset-0 bg-secondary-container translate-x-base translate-y-base group-active:translate-x-0 group-active:translate-y-0 transition-all"></div>
      <button
        id="construction-ping"
        class="relative bg-primary text-background font-label-md text-label-md px-lg py-sm border-thick border-primary group-hover:-translate-x-1 group-hover:-translate-y-1 transition-transform flex items-center gap-sm uppercase font-bold"
      >
        <span class="material-symbols-outlined" data-construction-icon>terminal</span>
        <span data-construction-label>{t('construction.ping', lang)}</span>
      </button>
    </div>

    <!-- Structural frame (bottom-right) -->
    <div class="absolute -bottom-xl -right-xl w-md h-md border-b-thick border-r-thick border-secondary-container hidden md:block"></div>
  </div>

  <!-- Terminal footer -->
  <div class="absolute bottom-md left-lg right-lg flex flex-col md:flex-row justify-between items-end border-t-thin border-outline-variant pt-sm gap-sm opacity-50">
    <div class="font-label-sm text-label-sm text-on-surface-variant">
      LOG: {buildDate} UTC | STDOUT_PIPE: SUCCESS
    </div>
    <div class="font-label-sm text-label-sm text-on-surface-variant">
      CAPSLOCKED_DEV // CORE_v2.0.4-BETA
    </div>
  </div>
</main>

<style>
  /* Right/bottom thick borders not provided by global.css utilities */
  .border-r-thick { border-right-width: 3px; }
  .border-b-thick { border-bottom-width: 3px; }
</style>

<script>
  function initConstructionPing() {
    const btn = document.getElementById('construction-ping');
    if (!btn || btn.dataset.wired === '1') return;
    btn.dataset.wired = '1';

    const icon = btn.querySelector('[data-construction-icon]') as HTMLElement | null;
    const label = btn.querySelector('[data-construction-label]') as HTMLElement | null;
    if (!icon || !label) return;

    const originalIcon = icon.textContent;
    const originalLabel = label.textContent;

    btn.addEventListener('click', () => {
      icon.textContent = 'sync';
      label.textContent = 'PINGING...';
      btn.classList.add('!bg-secondary-container');

      setTimeout(() => {
        icon.textContent = 'check_circle';
        label.textContent = '200 OK';
        setTimeout(() => {
          icon.textContent = originalIcon;
          label.textContent = originalLabel;
          btn.classList.remove('!bg-secondary-container');
        }, 2000);
      }, 800);
    });
  }

  document.addEventListener('DOMContentLoaded', initConstructionPing);
  document.addEventListener('astro:page-load', initConstructionPing);
</script>
