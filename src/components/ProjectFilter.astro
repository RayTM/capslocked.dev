---
import { t } from '../data/i18n';

interface Props {
  lang: string;
  tags: string[];
}

const { lang, tags } = Astro.props;
---

{/* Filters the already-rendered cards client-side — no extra routes, no page
   reload. Without JS every project stays visible, which is the correct
   fallback for a static site. */}
<div class="mb-md md:mb-lg flex flex-col gap-sm" data-project-filter>
  <div class="flex flex-wrap items-center gap-xs">
    <span class="font-label-sm text-label-sm text-outline uppercase mr-xs" aria-hidden="true">&gt;&gt; {t('filter.tags', lang)}</span>
    <button type="button" class="filter-chip" data-filter-tag="" aria-pressed="true">{t('filter.all', lang)}</button>
    {tags.map((tag) => (
      <button type="button" class="filter-chip" data-filter-tag={tag} aria-pressed="false">{tag}</button>
    ))}
  </div>
  <div class="flex flex-wrap items-center gap-xs">
    <span class="font-label-sm text-label-sm text-outline uppercase mr-xs" aria-hidden="true">&gt;&gt; {t('filter.status', lang)}</span>
    <button type="button" class="filter-chip" data-filter-active aria-pressed="false">{t('filter.activeOnly', lang)}</button>
  </div>
</div>

<p class="hidden font-label-md text-label-md text-outline uppercase py-lg" data-filter-empty>
  {t('filter.empty', lang)}
</p>

<style>
  .filter-chip {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.2;
    text-transform: uppercase;
    padding: 6px 12px;
    border: 1px solid var(--c-outline-variant);
    color: var(--c-on-surface-variant);
    background: transparent;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }
  .filter-chip:hover {
    color: var(--c-secondary);
    border-color: var(--c-secondary);
  }
  .filter-chip[aria-pressed='true'] {
    background: var(--c-secondary-container);
    border-color: var(--c-secondary-container);
    color: var(--c-on-secondary);
  }
  .filter-chip:focus-visible {
    outline: 2px solid var(--c-secondary);
    outline-offset: 2px;
  }
</style>

<script>
  /* Tag filter is single-select (empty value = all); the ACTIVE toggle is an
     independent flag. Both must match for a card to stay visible. */
  function initProjectFilter() {
    const root = document.querySelector<HTMLElement>('[data-project-filter]');
    /* astro:page-load also fires on the initial load — guard against binding twice. */
    if (!root || root.dataset.filterInit) return;
    root.dataset.filterInit = '1';

    const tagButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter-tag]'));
    const activeButton = root.querySelector<HTMLButtonElement>('[data-filter-active]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-card]'));
    const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
    /* Containers collapse when every card inside them is filtered out, so the
       flex gaps between highlight and grid don't leave dead space. */
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-project-group]'));

    let activeTag = '';
    let activeOnly = false;

    function apply() {
      let visible = 0;
      for (const card of cards) {
        const tags = (card.dataset.tags || '').split('|');
        const matchesTag = !activeTag || tags.includes(activeTag);
        const matchesActive = !activeOnly || card.dataset.active === 'true';
        const show = matchesTag && matchesActive;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      }

      for (const group of groups) {
        const hasVisible = group.querySelector('[data-project-card]:not(.hidden)') !== null;
        group.classList.toggle('hidden', !hasVisible);
      }

      empty?.classList.toggle('hidden', visible > 0);
    }

    for (const button of tagButtons) {
      button.addEventListener('click', () => {
        activeTag = button.dataset.filterTag || '';
        for (const other of tagButtons) {
          other.setAttribute('aria-pressed', String(other === button));
        }
        apply();
      });
    }

    activeButton?.addEventListener('click', () => {
      activeOnly = !activeOnly;
      activeButton.setAttribute('aria-pressed', String(activeOnly));
      apply();
    });
  }

  initProjectFilter();
  document.addEventListener('astro:page-load', initProjectFilter);
</script>
