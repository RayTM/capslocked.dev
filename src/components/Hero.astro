---
interface Props {
    eyebrow: string;
    title: string;
    /* Rendered directly after title in secondary color — e.g. "_WALTER." */
    titleAccent?: string;
    text: string;
}

const { eyebrow, title, titleAccent, text } = Astro.props;
---

{/* Fills the viewport below header (~75px) + main's pt-xl (80px), so the
   divider lands roughly at the fold. */}
<section
    class="relative overflow-hidden flex flex-col justify-center min-h-[calc(100svh-160px)]"
>
    {/* ASCII swirl backdrop — pool-drain vortex rendered as a dithered
       density field (log-spiral bands, ASCII ramp). Eight phase-shifted
       frames spanning the full 2π phase period crossfade in a seamless
       loop so the vortex slowly rotates; static per-cell grit keeps it
       from flickering. Each frame is two layers with identical metrics:
       full art in outline color, dense band cores in secondary.
       Regenerate via scratchpad swirl.mjs patch mode. */}
    <div
        aria-hidden="true"
        class="absolute inset-y-0 right-0 z-0 flex items-center"
    >
        <div class="swirl-parallax relative will-change-transform">
<div class="swirl-frame">
