    <div class="relative z-10 py-xl">
        {/* Terminal-prompt eyebrow: accent prompt char, muted label, blinking
           block cursor. */}
        <div
            class="flex items-center gap-xs mb-md font-label-md text-[13px] md:text-[16px] font-medium uppercase tracking-[0.2em]"
        >
            <span class="text-secondary" aria-hidden="true">~$</span>
            <span class="text-on-surface-variant">{eyebrow}</span>
            <span class="eyebrow-cursor bg-secondary" aria-hidden="true"></span>
        </div>
        <h1
            class="font-headline-xl text-[clamp(2.5rem,9vw,6rem)] leading-[1.02] tracking-[-0.04em] font-extrabold break-words mb-lg"
        >
            {title}{
                titleAccent && <span class="text-secondary">{titleAccent}</span>
            }
        </h1>
        <p class="font-body-lg text-body-lg max-w-lg text-on-surface-variant">
            {text}
        </p>
    </div>
</section>

<style>
    /* Tight line-height + zero tracking so the density field stays a grid. */
    .swirl-layer {
        font-family: "JetBrains Mono Variable", "JetBrains Mono", monospace;
        line-height: 1.3;
        letter-spacing: 0;
        white-space: pre;
        pointer-events: none;
        user-select: none;
    }

    /* Continuous triangle crossfade: each frame ramps 0→1→0 over 25% of
       the cycle with no hold plateau; staggered negative delays (-2s
       steps, 8 frames) keep exactly two adjacent frames blending at any
       moment with opacities summing to 1. Wrapper opacity multiplies
       with the per-layer Tailwind opacities, keeping the backdrop
       subtle. */
    .swirl-frame {
        opacity: 0;
        animation: swirl-fade 16s linear infinite;
        will-change: opacity;
    }

    @keyframes swirl-fade {
        0% {
            opacity: 0;
        }
        12.5% {
            opacity: 1;
        }
        25% {
            opacity: 0;
        }
        100% {
            opacity: 0;
        }
    }

    .eyebrow-cursor {
        display: inline-block;
        width: 0.55em;
        height: 1.05em;
        animation: cursor-blink 1.1s steps(2, jump-none) infinite;
    }

    @keyframes cursor-blink {
        0% {
            opacity: 1;
        }
        50% {
            opacity: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .swirl-frame {
            animation: none;
        }
        .swirl-frame:first-child {
            opacity: 1;
        }
        .eyebrow-cursor {
            animation: none;
        }
    }
</style>

<script>
    /* Subtle mouse parallax on the ASCII vortex — lerped translate,
       desktop pointers only, stops itself once the hero leaves the DOM
       (View Transitions swap). */
    function initSwirlParallax() {
        const el = document.querySelector<HTMLElement>(".swirl-parallax");
        if (!el || el.dataset.parallaxInit) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;
        if (!window.matchMedia("(pointer: fine)").matches) return;
        el.dataset.parallaxInit = "1";

        let tx = 0,
            ty = 0,
            cx = 0,
            cy = 0;
        const onMove = (e: PointerEvent) => {
            tx = (e.clientX / window.innerWidth - 0.5) * -16;
            ty = (e.clientY / window.innerHeight - 0.5) * -12;
        };
        window.addEventListener("pointermove", onMove, { passive: true });

        const loop = () => {
            if (!document.body.contains(el)) {
                window.removeEventListener("pointermove", onMove);
                return;
            }
            cx += (tx - cx) * 0.05;
            cy += (ty - cy) * 0.05;
            el.style.transform = `translate3d(${cx.toFixed(2)}px, ${cy.toFixed(2)}px, 0)`;
            requestAnimationFrame(loop);
        };
        requestAnimationFrame(loop);
    }

    initSwirlParallax();
    document.addEventListener("astro:page-load", initSwirlParallax);
</script>
