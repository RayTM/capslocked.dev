---
import { t } from '../data/i18n';

interface Props {
  lang: string;
  variant?: 'startpage' | 'blog' | 'project';
  activePage?: 'projects' | 'blog' | 'connect';
  altLangUrl: string;
  hideNav?: boolean;
}

const { lang, variant = 'startpage', activePage = '', altLangUrl, hideNav = false } = Astro.props;

const homeHref = lang === 'en' ? '/' : '/de/';
/* On index page, use local anchors. On subpages, link back to index. */
const prefix = variant === 'startpage' ? '' : homeHref;

const navItems = [
  { label: t('nav.projects', lang), href: prefix + '#projects', key: 'projects' },
  { label: t('nav.blog', lang), href: prefix + '#blog', key: 'blog' },
  { label: t('nav.connect', lang), href: prefix + '#connect', key: 'connect' },
];

const altLangLabel = lang === 'en' ? 'DE' : 'EN';
---

<header class="relative w-full bg-background flex justify-between items-center px-lg py-md">
  <a href={homeHref} class="group flex items-center" aria-label="CAPSLOCKED.DEV — Home">
    <!-- Wordmark: .DEV dissolves into pixels that float off to the right -->
    <span class="logo-glitch relative font-headline-md text-[16px] md:text-headline-md font-bold tracking-tighter leading-none whitespace-nowrap pr-[1.6em]">
      <span class="text-primary group-hover:text-secondary transition-colors">CAPSLOCKED</span><span class="text-secondary">.DEV</span>
      <span class="logo-px logo-px-1 bg-secondary" aria-hidden="true"></span>
      <span class="logo-px logo-px-2 bg-secondary" aria-hidden="true"></span>
      <span class="logo-px logo-px-3 bg-secondary" aria-hidden="true"></span>
      <span class="logo-px logo-px-4 bg-secondary" aria-hidden="true"></span>
      <span class="logo-px logo-px-5 bg-secondary" aria-hidden="true"></span>
    </span>
  </a>

  <!-- Desktop nav -->
  {!hideNav && (
    <nav class="hidden md:flex gap-lg items-center absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
      {navItems.map((item) => (
        <a
          class="font-label-md text-label-md transition-all duration-75 active:translate-y-0.5 px-xs py-base text-primary hover:bg-secondary hover:text-on-secondary"
          href={item.href}
        >
          {item.label}
        </a>
      ))}
    </nav>
  )}

  <div class="flex items-center gap-sm md:gap-md">
    <a class="font-label-sm text-label-sm text-outline hover:text-secondary transition-colors cursor-pointer" href={altLangUrl}>{altLangLabel}</a>
    <button class="material-symbols-outlined text-primary hover:text-secondary transition-colors" data-theme-icon onclick="toggleTheme()" aria-label="Toggle theme">dark_mode</button>
    {!hideNav && (
      <button class="md:hidden material-symbols-outlined text-primary hover:text-secondary transition-colors" id="mobile-menu-toggle" onclick="toggleMobileMenu()" aria-label="Menu">menu</button>
    )}
  </div>
</header>

<!-- Sticky border bar — pins to top on scroll, doubles as reading progress on blog pages -->
<div class:list={[
  'sticky top-0 z-50 h-[3px] bg-primary',
  { 'reading-progress-header': variant === 'blog' || variant === 'project' },
]}></div>

<!-- Mobile menu overlay -->
{!hideNav && (
  <div id="mobile-menu" class="hidden mobile-menu-overlay">
    <button class="absolute top-4 right-4 material-symbols-outlined text-primary text-3xl" onclick="toggleMobileMenu()" aria-label="Close menu">close</button>
    {navItems.map((item) => (
      <a
        class:list={[
          'font-headline-lg text-headline-lg uppercase transition-colors',
          item.key === activePage ? 'text-secondary' : 'text-primary hover:text-secondary',
        ]}
        href={item.href}
        onclick="toggleMobileMenu()"
      >
        {item.label}
      </a>
    ))}
    <div class="flex items-center gap-md mt-lg">
      <a class="font-label-md text-label-md text-outline hover:text-secondary transition-colors cursor-pointer" href={altLangUrl}>{altLangLabel}</a>
      <button class="material-symbols-outlined text-primary hover:text-secondary transition-colors text-3xl" data-theme-icon onclick="toggleTheme()" aria-label="Toggle theme">dark_mode</button>
    </div>
  </div>
)}

<style>
  /* Pixels drifting away to the right of the wordmark */
  .logo-px {
    position: absolute;
    animation: logo-px-a 2.8s linear infinite;
  }
  .logo-px-1 { right: 1.45em; top: 0.08em; width: 0.16em; height: 0.16em; }
  .logo-px-2 { right: 1.15em; top: 0.5em;  width: 0.11em; height: 0.11em; animation-name: logo-px-b; animation-duration: 3.4s; animation-delay: 0.6s; }
  .logo-px-3 { right: 1.3em;  bottom: 0;   width: 0.13em; height: 0.13em; animation-name: logo-px-c; animation-duration: 3s;   animation-delay: 1.1s; }
  .logo-px-4 { right: 0.95em; top: 0.22em; width: 0.09em; height: 0.09em; animation-duration: 2.5s; animation-delay: 1.6s; }
  .logo-px-5 { right: 1.5em;  top: 0.72em; width: 0.1em;  height: 0.1em;  animation-name: logo-px-b; animation-duration: 3.8s; animation-delay: 0.3s; }

  @keyframes logo-px-a {
    0%   { transform: translate(0, 0); opacity: 0; }
    15%  { opacity: 1; }
    70%  { opacity: 0.9; }
    100% { transform: translate(0.7em, -0.25em); opacity: 0; }
  }
  @keyframes logo-px-b {
    0%   { transform: translate(0, 0); opacity: 0; }
    15%  { opacity: 1; }
    70%  { opacity: 0.85; }
    100% { transform: translate(0.55em, 0.3em); opacity: 0; }
  }
  @keyframes logo-px-c {
    0%   { transform: translate(0, 0); opacity: 0; }
    15%  { opacity: 1; }
    70%  { opacity: 0.9; }
    100% { transform: translate(0.8em, -0.05em); opacity: 0; }
  }

  /* RGB-split glitch on the wordmark — one short choppy flicker per hover. */
  .group:hover .logo-glitch {
    animation: logo-glitch-anim 0.35s steps(2, jump-none) 1;
  }
  @keyframes logo-glitch-anim {
    0% {
      text-shadow: 2px 0 var(--c-secondary-container), -2px 0 var(--c-outline);
      transform: translate(-1px, 1px);
    }
    33% {
      text-shadow: -2px 0 var(--c-secondary-container), 2px 0 var(--c-outline);
      transform: translate(1px, -1px);
    }
    66% {
      text-shadow: 1px 0 var(--c-secondary-container), -1px 0 var(--c-outline);
      transform: translate(-1px, 0);
    }
    100% {
      text-shadow: none;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-px { animation: none; opacity: 0.7; }
    .group:hover .logo-glitch { animation: none; }
  }
</style>
