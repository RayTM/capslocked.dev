---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PostRow from '../../components/PostRow.astro';
import { posts } from '../../data/posts';

const lang = 'de';
const altLangUrl = '/blog/';
---

<BaseLayout
  title="BLOG // CAPSLOCKED.DEV"
  gridBg={true}
  lang={lang}
  description="Alle Blog-Einträge — Engineering-Journal und Entwicklungs-Logs von Lukas Walter."
>
  <Header lang={lang} activePage="blog" variant="blog" altLangUrl={altLangUrl} />
  <main class="max-w-7xl mx-auto px-md md:px-lg pt-lg md:pt-xl pb-lg md:pb-xl flex-grow">
    <SectionHeading>ALLE_EINTRÄGE</SectionHeading>
    <div>
      {posts.map((post) => (
        <PostRow post={post} lang={lang} />
      ))}
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
