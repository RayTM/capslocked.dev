---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Footer from '../../components/Footer.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PostRow from '../../components/PostRow.astro';
import LinkRow from '../../components/LinkRow.astro';
import { homeTeasers } from '../../data/projects';
import { posts } from '../../data/posts';
import { links } from '../../data/links';

const lang = 'de';
const altLangUrl = '/';
const { highlight, secondary } = homeTeasers();
---

<BaseLayout title="CAPSLOCKED.DEV // ROOT-ZUGANG" gridBg={true} lang={lang} construction={false}>
  <Header lang={lang} activePage="projects" variant="startpage" altLangUrl={altLangUrl} />
  <main class="max-w-7xl mx-auto px-md md:px-lg pt-lg md:pt-xl">
    <!-- Hero Section -->
    <Hero
      eyebrow="HALLO, ICH BIN"
      title="LUKAS"
      titleAccent="_WALTER."
      text="TYPO3- und PHP-Entwickler, der sich gerade in DevOps einarbeitet. Tagsüber baue ich Extensions und Backends — danach geht es um Docker, CI/CD-Pipelines und selbst gehostete Infrastruktur. Diese Seite läuft darauf."
    />

    <!-- Projekte — ein Highlight oben, zwei Teaser darunter -->
    <section class="py-lg md:py-xl" id="projects">
      <SectionHeading href="/de/projects" linkLabel="ALLE_PROJEKTE">AKTUELLE_PROJEKTE</SectionHeading>
      {highlight && (
        <ProjectCard project={highlight} lang={lang} variant="highlighted" />
      )}
      {secondary.length > 0 && (
        <div class="grid gap-md mt-md md:mt-lg grid-cols-1 md:grid-cols-2">
          {secondary.map((project) => (
            <ProjectCard project={project} lang={lang} variant="grid" />
          ))}
        </div>
      )}
    </section>

    <!-- Blog -->
    <section class="py-lg md:py-xl" id="blog">
      <SectionHeading href="/de/blog" linkLabel="ALLE_EINTRÄGE">AKTUELLE_EINTRÄGE</SectionHeading>
      <div>
        {posts.map((post) => (
          <PostRow post={post} lang={lang} />
        ))}
      </div>
    </section>

    <!-- Kontakt -->
    <section class="py-lg md:py-xl" id="connect">
      <SectionHeading>VERBINDUNG_HERSTELLEN</SectionHeading>
      <div>
        {links.map((link) => (
          <LinkRow link={link} lang={lang} />
        ))}
      </div>
    </section>
  </main>
  <Footer lang={lang} variant="startpage" />
</BaseLayout>
