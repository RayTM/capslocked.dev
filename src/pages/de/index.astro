---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PostRow from '../../components/PostRow.astro';
import LinkRow from '../../components/LinkRow.astro';
import { projects } from '../../data/projects';
import { posts } from '../../data/posts';
import { links } from '../../data/links';

const lang = 'de';
const altLangUrl = '/';
const highlighted = projects.filter(p => p.highlighted);
const grid = projects.filter(p => !p.highlighted);
---

<BaseLayout title="CAPSLOCKED.DEV // ROOT-ZUGANG" gridBg={true} lang={lang}>
  <div class="scanline"></div>
  <Header lang={lang} activePage="projects" variant="startpage" altLangUrl={altLangUrl} />
  <main class="max-w-7xl mx-auto px-lg pt-xl">
    <!-- Hero Section -->
    <section class="min-h-[819px] flex flex-col justify-center items-center text-center py-xl">
      <div class="border-thick border-primary p-md md:p-lg bg-surface-container-low brutalist-shadow mb-lg max-w-full">
        <h1 class="font-headline-xl text-[32px] md:text-headline-xl leading-[1.1] tracking-[-0.04em] font-extrabold mb-md">SYSTEM_BEREIT.</h1>
        <p class="font-body-lg text-body-lg max-w-2xl mx-auto text-on-surface-variant">
          Ich bin ein Full-Stack-Ingenieur mit Spezialisierung auf strukturelle Integrität und terminale Schnittstellen.
          Ich baue Werkzeuge für die technische Elite — rohe Leistung und kompromissloser Brutalismus.
        </p>
      </div>
      <div class="flex gap-md">
        <a class="bg-primary text-background px-lg py-sm font-label-md text-label-md border-thick border-primary hover:bg-secondary-container hover:text-white transition-all brutalist-shadow active:translate-y-1" href="#connect">VERBINDUNG_INITIALISIEREN</a>
      </div>
    </section>

    <!-- Hervorgehobenes Projekt -->
    <section class="py-xl" id="projects">
      <SectionHeading>AKTUELLES_PROJEKT</SectionHeading>
      {highlighted.map((project) => (
        <ProjectCard project={project} lang={lang} variant="highlighted" />
      ))}
      {/* Raster-Projekte — max 3 Spalten */}
      {grid.length > 0 && (
        <div class:list={[
          'grid gap-md mt-lg',
          grid.length === 1 ? 'grid-cols-1' : grid.length === 2 ? 'grid-cols-1 md:grid-cols-2' : 'grid-cols-1 md:grid-cols-3',
        ]}>
          {grid.map((project) => (
            <ProjectCard project={project} lang={lang} variant="grid" />
          ))}
        </div>
      )}
    </section>

    <!-- Blog -->
    <section class="py-xl border-t-thin border-outline-variant" id="blog">
      <SectionHeading>AKTUELLE_EINTRÄGE</SectionHeading>
      <div class="space-y-base">
        {posts.map((post) => (
          <PostRow post={post} lang={lang} />
        ))}
      </div>
    </section>

    <!-- Kontakt -->
    <section class="py-xl border-t-thin border-outline-variant" id="connect">
      <SectionHeading>UPLINK_HERSTELLEN</SectionHeading>
      <div class="space-y-base">
        {links.map((link) => (
          <LinkRow link={link} lang={lang} />
        ))}
      </div>
    </section>
  </main>
  <Footer lang={lang} variant="startpage" />
</BaseLayout>
