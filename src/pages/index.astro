---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import LinkRow from '../components/LinkRow.astro';
import { projects } from '../data/projects';
import { posts } from '../data/posts';
import { links } from '../data/links';

const lang = 'en';
const altLangUrl = '/de';
const highlighted = projects.filter(p => p.highlighted);
const grid = projects.filter(p => !p.highlighted);
---

<BaseLayout title="CAPSLOCKED.DEV // ROOT ACCESS" gridBg={true} lang={lang}>
  <div class="scanline"></div>
  <Header lang={lang} activePage="projects" variant="startpage" altLangUrl={altLangUrl} />
  <main class="max-w-7xl mx-auto px-lg pt-xl">
    <!-- Hero Section -->
    <section class="min-h-[819px] flex flex-col justify-center items-center text-center py-xl">
      <div class="border-thick border-primary p-md md:p-lg bg-surface-container-low brutalist-shadow mb-lg max-w-full">
        <h1 class="font-headline-xl text-[32px] md:text-headline-xl leading-[1.1] tracking-[-0.04em] font-extrabold mb-md">SYSTEM_READY.</h1>
        <p class="font-body-lg text-body-lg max-w-2xl mx-auto text-on-surface-variant">
          I am a full-stack engineer specializing in structural integrity and terminal-grade interfaces.
          I build tools for the technical elite, focusing on raw performance and unapologetic brutalism.
        </p>
      </div>
      <div class="flex gap-md">
        <a class="bg-primary text-background px-lg py-sm font-label-md text-label-md border-thick border-primary hover:bg-secondary-container hover:text-white transition-all brutalist-shadow active:translate-y-1" href="#connect">INITIALIZE_CONNECT</a>
      </div>
    </section>

    <!-- Highlighted Project -->
    <section class="py-xl" id="projects">
      <SectionHeading>CURRENT_PROJECT</SectionHeading>
      {highlighted.map((project) => (
        <ProjectCard project={project} lang={lang} variant="highlighted" />
      ))}
      {/* Grid projects — max 3 cols */}
      {grid.length > 0 && (
        <div class:list={[
          'grid gap-md mt-lg',
          grid.length === 1 ? 'grid-cols-1' : grid.length === 2 ? 'grid-cols-1 md:grid-cols-2' : 'grid-cols-1 md:grid-cols-3',
        ]}>
          {grid.map((project) => (
            <ProjectCard project={project} lang={lang} variant="grid" />
          ))}
        </div>
      )}
    </section>

    <!-- Blog -->
    <section class="py-xl border-t-thin border-outline-variant" id="blog">
      <SectionHeading>RECENT_LOGS</SectionHeading>
      <div class="space-y-base">
        {posts.map((post) => (
          <PostRow post={post} lang={lang} />
        ))}
      </div>
    </section>

    <!-- Connect -->
    <section class="py-xl border-t-thin border-outline-variant" id="connect">
      <SectionHeading>ESTABLISH_UPLINK</SectionHeading>
      <div class="space-y-base">
        {links.map((link) => (
          <LinkRow link={link} lang={lang} />
        ))}
      </div>
    </section>
  </main>
  <Footer lang={lang} variant="startpage" />
</BaseLayout>
