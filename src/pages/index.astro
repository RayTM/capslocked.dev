---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PostRow from "../components/PostRow.astro";
import LinkRow from "../components/LinkRow.astro";
import { homeTeasers } from "../data/projects";
import { posts } from "../data/posts";
import { links } from "../data/links";

const lang = "en";
const altLangUrl = "/de";
const { highlight, secondary } = homeTeasers();
---

<BaseLayout
    title="CAPSLOCKED.DEV // ROOT ACCESS"
    gridBg={true}
    lang={lang}
    construction={false}
>
    <Header
        lang={lang}
        activePage="projects"
        variant="startpage"
        altLangUrl={altLangUrl}
    />
    <main class="max-w-7xl mx-auto px-md md:px-lg pt-lg md:pt-xl">
        <!-- Hero Section -->
        <Hero
            eyebrow="HEY, I AM"
            title="LUKAS"
            titleAccent="_WALTER."
            text="TYPO3 and PHP developer, currently leveling up in DevOps. By day I build extensions and backends — after hours I wrestle with Docker, CI/CD pipelines and self-hosted infrastructure. This site runs on it."
        />

        <!-- Projects — one highlight on top, two teasers below -->
        <section class="py-lg md:py-xl" id="projects">
            <SectionHeading href="/projects" linkLabel="ALL_PROJECTS">CURRENT_PROJECTS</SectionHeading>
            {highlight && (
                <ProjectCard
                    project={highlight}
                    lang={lang}
                    variant="highlighted"
                />
            )}
            {secondary.length > 0 && (
                <div class="grid gap-md mt-md md:mt-lg grid-cols-1 md:grid-cols-2">
                    {secondary.map((project) => (
                        <ProjectCard
                            project={project}
                            lang={lang}
                            variant="grid"
                        />
                    ))}
                </div>
            )}
        </section>

        <!-- Blog -->
        <section class="py-lg md:py-xl" id="blog">
            <SectionHeading href="/blog" linkLabel="ALL_LOGS">RECENT_LOGS</SectionHeading>
            <div>
                {posts.map((post) => <PostRow post={post} lang={lang} />)}
            </div>
        </section>

        <!-- Connect -->
        <section class="py-lg md:py-xl" id="connect">
            <SectionHeading>ESTABLISH_CONNECTION</SectionHeading>
            <div>
                {links.map((link) => <LinkRow link={link} lang={lang} />)}
            </div>
        </section>
    </main>
    <Footer lang={lang} variant="startpage" />
</BaseLayout>
