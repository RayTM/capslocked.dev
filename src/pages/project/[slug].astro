---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SubpageLayout from '../../components/SubpageLayout.astro';
import LinkRow from '../../components/LinkRow.astro';
import type { Badge } from '../../components/SubpageLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((p) => p.id.startsWith('en/'))
    .map((project) => {
      const slug = project.id.replace('en/', '');
      return { params: { slug }, props: { project } };
    });
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, status, dateRange, category, image, links } = project.data;
const slug = project.id.replace('en/', '');

const badges: Badge[] = [
  { text: status, variant: 'filled' },
  { text: dateRange, variant: 'outline' },
  { text: category, variant: 'accent' },
];
---

<BaseLayout title={`${title} // PROJECT DETAIL`} brutalistRadius={true} gridBg={true} lang="en" description={description} ogImage={image.src}>
  <Header lang="en" activePage="projects" variant="project" altLangUrl={`/de/project/${slug}`} />
  <SubpageLayout
    lang="en"
    badges={badges}
    title={title}
    description={description}
    heroImage={image}
  >
    <div class="prose-brutalist">
      <Content />
    </div>
    {links.length > 0 && (
      <div class="mt-lg">
        {links.map((link) => (
          <LinkRow link={{
            href: link.href,
            external: link.external,
            icon: link.icon,
            translations: {
              en: { label: link.label, description: link.description },
            },
          }} lang="en" />
        ))}
      </div>
    )}
  </SubpageLayout>
  <Footer lang="en" />
</BaseLayout>
