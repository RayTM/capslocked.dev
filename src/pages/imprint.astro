---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t } from '../data/i18n';

const lang = 'en';
---

<BaseLayout title="IMPRINT // CAPSLOCKED.DEV" brutalistRadius={true} gridBg={true} lang={lang} description="Legal disclosure and contact information.">
  <Header lang={lang} activePage="" variant="project" altLangUrl="/de/imprint" hideNav={true} />
  <main class="pt-lg md:pt-xl pb-xl px-md md:px-lg max-w-3xl mx-auto overflow-x-hidden">
    <header class="mb-lg">
      <div class="flex items-center gap-x-sm font-label-sm text-label-sm uppercase tracking-[0.08em] mb-md">
        <span class="text-secondary" aria-hidden="true">&gt;&gt;</span>
        <span class="text-secondary">LEGAL</span>
      </div>
      <h1 class="font-headline-xl text-[32px] md:text-[48px] leading-[1.05] tracking-[-0.02em] font-extrabold text-primary uppercase break-words mb-md">
        IMPRINT
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant border-l-thick border-secondary pl-md">
        Legal disclosure pursuant to § 5 TMG.
      </p>
    </header>

    <article class="text-on-background prose-brutalist">
      <h2>01 // CONTACT</h2>
      <p>
        <strong>Lukas Walter</strong><br />
        Viehofer Straße 56<br />
        45127 Essen<br />
        Deutschland
      </p>
      <p>
        <strong>Email:</strong> <a href="mailto:capslocked_de@proton.me">capslocked_de@proton.me</a><br />
        <strong>Phone:</strong> <a href="tel:+491729049182">+49 172 9049182</a>
      </p>

      <h2>02 // RESPONSIBLE FOR CONTENT</h2>
      <p>
        Responsible according to § 55 Abs. 2 RStV:<br />
        <strong>Lukas Walter</strong><br />
        Address as above
      </p>

      <h2>03 // DISCLAIMER</h2>
      <p>
        The contents of this website have been created with the utmost care. However, no guarantee can be given for the correctness, completeness, and timeliness of the content. As a service provider, I am responsible for my own content on these pages under general law. However, I am not obligated to monitor transmitted or stored third-party information or to investigate circumstances that indicate illegal activity.
      </p>

      <h2>04 // EXTERNAL LINKS</h2>
      <p>
        This website contains links to external third-party websites over whose content I have no influence. Therefore, no guarantee can be made for this external content. The respective provider or operator of the linked pages is always responsible for the content of the linked pages.
      </p>
    </article>

    <section class="mt-xl pt-lg border-t-thin border-outline-variant">
      <div class="font-label-sm text-label-sm text-outline uppercase mb-md" aria-hidden="true">// EOF</div>
      <a
        class="group inline-flex items-center gap-xs font-label-md text-label-md uppercase tracking-[0.1em] text-on-surface-variant hover:text-secondary transition-colors"
        href="/"
      >
        <span class="material-symbols-outlined text-[18px] transition-transform group-hover:-translate-x-1" aria-hidden="true">arrow_back</span>
        <span>{t('backToHome.label', lang)}</span>
        <span class="text-primary group-hover:text-secondary transition-colors">CAPSLOCKED.DEV</span>
      </a>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>
